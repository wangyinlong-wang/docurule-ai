# Copy to .env only when you need to override these defaults.
DOCURULE_DATA_DIR=./data
DOCURULE_MAX_UPLOAD_MB=20

# local | ollama | openai-compatible
DOCURULE_AI_PROVIDER=ollama
DOCURULE_AI_BASE_URL=http://host.docker.internal:11434
DOCURULE_AI_MODEL=gemma4:latest
DOCURULE_AI_API_KEY=

# Browser origin used by local development.
DOCURULE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
